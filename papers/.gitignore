# LaTeX build products. Note the repository root .gitignore already covers
# *.log, which includes main.log.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.run.xml
*.bcf
*.pdf
# Figures are generated by tools/make_figures.py but committed, so the paper
# stays buildable without a run directory.
!**/plots/*.pdf
